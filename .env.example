# Supabase Database (Project Settings → Database → Connection string)
DATABASE_URL=             # Transaction pooler (포트 6543), 앱 런타임용
DIRECT_URL=               # Direct/Session (포트 5432), 마이그레이션용

# Supabase Storage/API (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API (사진 판정용 vision 모델 호출)
OPENAI_API_KEY=
OPENAI_VISION_MODEL="gpt-4o-mini"

# Naver Cloud Platform Maps (신상품 'Maps', 구 AI NAVER API 아님)
# Web Dynamic Map JS SDK 키 (브라우저 노출용, NEXT_PUBLIC_ 접두사 필수)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Geocoding/Reverse Geocoding REST API 인증용 (서버 전용, 브라우저에 노출되면 안 됨)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# 관리자 화면 접근용 비밀 URL 경로 슬러그 (로그인 없음, /admin/{슬러그}로만 접근)
ADMIN_SECRET_PATH=

# Cloudflare R2 (dash.cloudflare.com → R2 Object Storage → Manage API Tokens)
# 갤러리 완성 영상 전용 저장소 — Supabase 트래픽/pause와 무관하게 계속 살아있게
# 하려고 2026-09-23에 옮김. 사진은 그대로 Supabase Storage에 남아있다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=borderless
R2_ENDPOINT=                       # https://<account-id>.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=         # R2 버킷 Settings → Public Access에서 켠 r2.dev URL

# Vercel Cron 인증용 (Supabase 무료 플랜 7일 비활성 pause 방지 — /api/cron/ping-supabase)
# 아무 긴 난수 문자열. Vercel 프로젝트 환경변수에도 같은 이름으로 등록해야 cron 요청에 Bearer로 붙는다.
CRON_SECRET=

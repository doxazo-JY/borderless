// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MissionType {
  WORD
  PRAISE
  PRAYER
  CONFESSION
}

enum CapStatus {
  AVAILABLE
  CLOSED
}

enum GrantStatus {
  PENDING
  CONFIRMED
}

enum HelpRequestStatus {
  OPEN
  RESOLVED
}

// 참가자 팀/조 선택 관련 전역 설정. 항상 딱 한 행만 존재한다(getOrCreate로 보장).
model AppSettings {
  id                   String  @id @default(cuid())
  groupSelectionLocked Boolean @default(false)
  // AI 판정 API가 막혔을 때(크레딧 소진/장애 등) 임원이 수동으로 켜는 스위치 —
  // 켜져 있는 동안 참가자 화면 상단에 "임원 수동 평가 진행 중" 배너가 계속 표시된다.
  aiJudgingDisabled    Boolean @default(false)
}

model Team {
  id     String  @id @default(cuid())
  name   String  @unique // A/B/C/D
  groups Group[]
}

model Region {
  id          String             @id @default(cuid())
  name        String             @unique // a/b/c/d
  // 실제 4지역 방문 순서/캡/완료 로직과 완전히 분리된 데모용 지역인지 여부.
  // true인 지역의 포인트는 GroupRegionOrder에 안 넣어도(못 넣어도) 항상 접근
  // 가능해야 해서, 방문 순서 강제(targetRegionId 비교)를 이 플래그로 우회한다.
  isExample   Boolean            @default(false)
  locations   Location[]
  groupOrders GroupRegionOrder[]
}

model Group {
  id           String             @id @default(cuid())
  teamId       String
  team         Team               @relation(fields: [teamId], references: [id])
  groupNumber  Int // 1 or 2
  displayName  String
  memberName1  String? // 어드민이 미리 등록 — 참가자가 매번 입력할 필요 없게
  memberName2  String?
  regionOrder  GroupRegionOrder[]
  submissions  Submission[]
  helpRequests HelpRequest[]

  @@unique([teamId, groupNumber])
}

// 그룹별 강제 지역 방문 순서 (8그룹 각자 별도, position 0~3)
model GroupRegionOrder {
  id       String @id @default(cuid())
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id])
  regionId String
  region   Region @relation(fields: [regionId], references: [id])
  position Int // 0~3

  @@unique([groupId, regionId])
  @@unique([groupId, position])
}

model Mission {
  id                  String      @id @default(cuid())
  type                MissionType
  content             String // 말씀 본문/기도 주제/고백 지시문. 찬양(PRAISE)은 빈 문자열 허용
  imageUrl            String? // 참고 이미지가 있는 경우 content와 함께 표시
  locationsAsMission1 Location[] @relation("LocationMission1")
  locationsAsMission2 Location[] @relation("LocationMission2")
}

model Ingredient {
  id        String     @id @default(cuid())
  name      String
  locations Location[] @relation("LocationIngredients")
}

model Location {
  id                String        @id @default(cuid())
  regionId          String
  region            Region        @relation(fields: [regionId], references: [id])
  name              String
  isActive          Boolean       @default(true)
  address           String? // 보조 입력 수단 (사전 계획용). 현장에서는 GPS로 lat/lng 직접 입력이 메인
  lat               Float
  lng               Float
  referencePhotoUrl String?
  judgePrompt       String        @default("기준 사진과 동일한 장소/사물이 보이는가?")
  mission1Id        String? // 슬롯1 — 이 포인트에 먼저 AI 판정 통과한 조가 받는 미션
  mission1          Mission?      @relation("LocationMission1", fields: [mission1Id], references: [id])
  mission2Id        String? // 슬롯2 — 두 번째로 통과한 조가 받는 미션 (겹치는 영상 파트 방지)
  mission2          Mission?      @relation("LocationMission2", fields: [mission2Id], references: [id])
  ingredients       Ingredient[]  @relation("LocationIngredients")
  capacity          Int           @default(2) // 항상 2로 고정, admin에서 편집 불가
  claimedCount      Int           @default(0)
  submissions       Submission[]
  helpRequests      HelpRequest[]
}

model Submission {
  id            String      @id @default(cuid())
  groupId       String
  group         Group       @relation(fields: [groupId], references: [id])
  locationId    String
  location      Location    @relation(fields: [locationId], references: [id])
  photoUrl      String?
  capStatus     CapStatus
  aiPassed      Boolean?
  aiReason      String?
  videoUrl      String?
  missionSlot   Int? // 이 제출이 획득한 미션 슬롯(1 또는 2) — AI 판정 통과 순서로 결정, CLOSED/실패 제출은 null
  grantStatus   GrantStatus @default(PENDING)
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())
}

model HelpRequest {
  id             String            @id @default(cuid())
  groupId        String
  group          Group             @relation(fields: [groupId], references: [id])
  locationId     String? // 특정 장소 맥락 없이도(어떤 화면에서든) 요청 가능하도록 선택값
  location       Location?         @relation(fields: [locationId], references: [id])
  message        String? // 참가자가 적은 문제 설명
  requesterName  String? // 요청 시점 팀/조 선택 화면에서 입력한 참가자 이름 — 연락할 사람 특정용
  status         HelpRequestStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  // 임원이 "해결/통과 처리"까지 가기 전에 일단 "봤다"는 것만 참가자에게 먼저
  // 알려주기 위한 필드 — 언제 확인했는지가 아니라 확인 여부 자체가 필요해서
  // null이면 미확인, 값이 있으면 확인됨으로 취급한다.
  acknowledgedAt DateTime?
  // 확인함 이후 임원이 참가자에게 짧게 남기는 답장 ("사진 다시 확인 중이에요"
  // 등) — 상태 라벨만으로는 뭘 기다리는지 몰라 계속 불안해하는 걸 줄이려는 목적.
  adminMessage   String?
}
